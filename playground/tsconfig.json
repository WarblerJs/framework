{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "paths": {
      "@pg/*": ["database/warbler/pg/generated/*"],
      "@errors/*": ["src/shared/errors/*"],
      "@functions/*": ["src/shared/functions/*"],
      "@warblerjs/console": ["../packages/console/src/index.ts"],
      "@warblerjs/config": ["../packages/config/src/index.ts"],
      "@warblerjs/core": ["../packages/core/src/index.ts"],
      "@warblerjs/crypto": ["../packages/crypto/src/index.ts"],
      "@warblerjs/email": ["../packages/email/src/index.ts"],
      "@warblerjs/events": ["../packages/events/src/index.ts"],
      "@warblerjs/framework": ["../packages/framework/src/index.ts"],
      "@warblerjs/http": ["../packages/http/src/index.ts"],
      "@warblerjs/transport": ["../packages/transport/src/index.ts"],
      "@warblerjs/validators": ["../packages/validators/src/index.ts"],
      "@warblerjs/view": ["../packages/view/src/index.ts"],
      "@warblerjs/websocket": ["../packages/websocket/src/index.ts"],
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "database/**/*.ts"]
}
