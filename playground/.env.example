# development,production
APP_ENV=development
APP_HOST=0.0.0.0
APP_HTTP_PORT=3000
# Deprecated: use APP_HTTP_PORT. Remove this compatibility key in the next breaking release.
APP_HTTTP_PORT=3000
HTTP_ALLOWED_ORIGINS=localhost,127.0.0.1

HTTP_ENABLED=true

WS_ENABLED=false
WS_PORT=3001
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.100:3000

TCP_ENABLED=false
TCP_PORT=9000

UDP_ENABLED=false
UDP_PORT=9001

MCP_ENABLED=false
MCP_PORT=8080

WEBRTC_ENABLED=false
WEBRTC_SIGNALING_PORT=3002

METRICS_ENABLED=false
METRICS_PORT=9090

HEALTH_CHECK_ENABLED=false
HEALTH_CHECK_PORT=8081

# Local development placeholder key material only. Replace before real deployments.
APP_CRYPTO_KEY=
APP_HMAC_KEY=

# Database commands use these values only when you run warbler db:pg commands.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=warbler_development
DB_USERNAME=warbler
DB_PASSWORD=
DB_LOG_QUERIES=false
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30
DB_CONNECTION_TIMEOUT=10

MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Warbler
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TLS_REJECT_UNAUTHORIZED=true
MAIL_TIMEOUT_MS=10000

WARBLER_HTTP_PROFILING=false
WARBLER_HTTP_PROFILING_SUMMARY=true
LOG_REQUESTS=true
LOG_RUNTIME=true
LOG_TRANSPORTS=true
LOG_WEBSOCKET=true
LOG_ERRORS=true
LOG_FATAL=true
LOG_STARTUP=true
LOG_DEBUG=true
LOG_CONSOLE=true
LOG_FILE=true
LOG_FILE_PATH=storage/logs
LOG_RETENTION_DAYS=14

# WebSocket
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
