{
  "name": "warbler",
  "version": "0.5.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "install:all": "bun install",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "clean": "rm -rf node_modules rm -rf playground/node_modules rm -f bun.lock rm -f playground/bun.lock",
    "test:request": "autocannon -c 50 -d 30 http://0.0.0.0:3000/users/45",
    "build": "cd playground && bun run build",
    "release": "bun run scripts/release.ts",
    "release:cli": "bun run scripts/release-cli.ts",
    "sync:versions": "bun run scripts/sync-version.ts",
    "check:versions": "bun run scripts/sync-version.ts --check",
    "smoke:packages": "bun run scripts/smoke-packed-packages.ts",
    "generate:cli-starter-configs": "bun run packages/cli/scripts/generate-starter-configs.ts",
    "check:cli-starter-configs": "bun run packages/cli/scripts/generate-starter-configs.ts --check",
    "generate:cli-starter-versions": "bun run packages/cli/scripts/generate-starter-package-versions.ts",
    "check:cli-starter-versions": "bun run packages/cli/scripts/generate-starter-package-versions.ts --check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
